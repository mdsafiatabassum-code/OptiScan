# Comma-separated origins allowed to call the API (your frontend URL).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local path of the ONNX model. Relative paths resolve from the backend folder.
MODEL_PATH=models/model.onnx
# Download location for the model if MODEL_PATH is missing. Set empty to disable downloads.
MODEL_URL=https://huggingface.co/fundusnap/fundusnap-v1-severitycls-rn34-22m/resolve/main/models/model.onnx
# SHA-256 of the model file. The app refuses a model that does not match.
MODEL_SHA256=5761ebf08d85172114a073a12a9d6a15e684bdd2e95368e4e716481e413f87de
# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=10
# Preliminary image-quality thresholds (uncalibrated). Brightness is the mean grey level, 0-255.
QUALITY_MIN_MEAN_BRIGHTNESS=25
QUALITY_MAX_MEAN_BRIGHTNESS=235
# Sharpness is the Laplacian variance on the grey image scaled to at most 512 px. Lower values are blurrier.
QUALITY_MIN_SHARPNESS=5
